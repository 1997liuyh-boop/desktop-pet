{
  "productName": "虚拟桌宠模拟器",
  "version": "0.1.0",
  "identifier": "com.desktop-pet.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pet",
        "title": "虚拟桌宠模拟器",
        "width": 250,
        "height": 250,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true,
        "center": false
      },
      {
        "label": "settings",
        "title": "设置 - 虚拟桌宠模拟器",
        "width": 420,
        "height": 720,
        "url": "settings.html",
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "visible": false,
        "center": true
      },
      {
        "label": "chat",
        "title": "聊天",
        "width": 360,
        "height": 520,
        "url": "chat.html",
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "visible": false,
        "center": true
      },
      {
        "label": "food-panel",
        "title": "投喂",
        "width": 280,
        "height": 440,
        "url": "food-panel.html",
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": false,
        "visible": false,
        "center": true
      },
      {
        "label": "work-panel",
        "title": "工作面板",
        "width": 280,
        "height": 460,
        "url": "work-panel.html",
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": false,
        "visible": false,
        "center": true
      },
      {
        "label": "status-panel",
        "title": "宠物状态",
        "width": 280,
        "height": 420,
        "url": "status-panel.html",
        "transparent": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../assets/pet-manifest.json"
    ]
  }
}